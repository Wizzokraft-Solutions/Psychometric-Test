# Copy this file to ".env" (which is gitignored) and fill in your Supabase values.
# Settings -> API in your Supabase project dashboard.

# Used by scripts/import-to-supabase.mjs (NEVER commit the real value):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY

# Used by the front-end app (safe to expose — these ship in the browser bundle):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
